# Build the pinned linux/appimage/Dockerfile as this local base first.
FROM firma-cie-appimage-base
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap dpkg-dev && \
    touch /work/.cie-appimage-isolated-root && rm -rf /var/lib/apt/lists/*
